bot_token=123456789:AA...your_bot_token_here
chat_id=-1001234567890

# PostgreSQL Database (optional - unset DATABASE_URL for intentional JSON fallback)
# Use host `postgres` when running through docker-compose.yml.
DATABASE_URL=postgresql://tgmonitor:change_this_password@postgres:5432/tgmonitoring
# DB_POOL_SIZE=5
# DB_TIMEOUT_SEC=10

# Optional tuning
# SAMPLE_INTERVAL_SEC=15
# ALERT_MIN_CONSECUTIVE=3
NODE_EXPORTER_URL=http://node-exporter:9100/metrics
# CPU_LOAD_PER_CORE_WARN=0.9
# MEM_AVAILABLE_PCT_WARN=0.10
# DISK_USAGE_PCT_WARN=0.85
# ENABLE_INODES=true
# INODE_FREE_PCT_WARN=0.10
# STATE_FILE=data/state.json

# RSS (optional)
# RSS_STORE_FILE=data/rss.json
# RSS_POLL_INTERVAL_SEC=300
# RSS_DIGEST_INTERVAL_SEC=3600
# RSS_DIGEST_ITEMS_PER_FEED=5
# RSS_DIGEST_MAX_TOTAL=40

# Watchdog (optional)
# Restart when idle threshold is hit.
# WATCHDOG_RESTART_ON_IDLE=false
# WATCHDOG_RESTART_COOLDOWN_MIN=30
# WATCHDOG_RESTART_CMD=/bin/systemctl restart tg-monitor.service
# WATCHDOG_RESTART_TIMEOUT_SEC=60

# Memory Configuration
# MEMORY_CACHE_SIZE=50
# MEMORY_ALERT_THRESHOLD_MB=100
# MEMORY_WARNING_THRESHOLD_MB=50
# MEMORY_MONITORING_ENABLED=true

# Chat Access Control
# ALLOW_ANY_CHAT=false
# CONTROL_CHAT_ID=
# HOST_DISPLAY_NAME=
# ALLOWED_CHATS=

# Modules (comma-separated). Shorthand resolves to tgbot.modules.<name>
# Default: monitoring,rss,help,stickers,qrcode
# Example: monitoring,rss,help
# MODULES=monitoring,rss,help,stickers,qrcode

# Node Exporter Configuration
# Server-host monitoring default: scrape the Compose-managed Node Exporter.
# server host = Ubuntu/VPS machine running Docker; bot container = tg-monitoring.
# Options: auto=scrape only, docker=app-managed server-host node-exporter,
# python=container-local when bot runs in Docker.
# python uses internal script: tgbot/modules/exporters/python/python_node_exporter.py
NODE_EXPORTER_TYPE=auto

# PostgreSQL (used by docker-compose.yml)
# Generate unique credentials and keep this file private
POSTGRES_DB=tgmonitoring
POSTGRES_USER=tgmonitor
POSTGRES_PASSWORD=change_this_password
