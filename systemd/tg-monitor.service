[Unit]
Description=Telegram Server Monitor (Docker-based)
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tg-monitoring
EnvironmentFile=/home/ubuntu/tg-monitoring/.env
ExecStartPre=/bin/sh -c "/usr/bin/docker network inspect tg-monitoring_net >/dev/null 2>&1 || /usr/bin/docker network create tg-monitoring_net"
ExecStart=/usr/bin/docker compose -f /home/ubuntu/tg-monitoring/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f /home/ubuntu/tg-monitoring/docker-compose.yml down
ExecReload=/usr/bin/docker compose -f /home/ubuntu/tg-monitoring/docker-compose.yml restart tg-monitoring
Restart=on-failure
RestartSec=10s

[Install]
WantedBy=multi-user.target
