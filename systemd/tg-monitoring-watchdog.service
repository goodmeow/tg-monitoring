[Unit]
Description=tg-monitoring log watchdog
After=tg-monitoring-log.service
Wants=tg-monitoring-log.service

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/tg-monitoring
EnvironmentFile=/home/ubuntu/tg-monitoring/.env
ExecStart=/usr/bin/python3 /home/ubuntu/tg-monitoring/scripts/log_watchdog.py --idle-min 10 --cooldown-min 10
StandardOutput=append:/home/ubuntu/tg-monitoring/logs/tg-monitoring-watchdog.log
StandardError=append:/home/ubuntu/tg-monitoring/logs/tg-monitoring-watchdog.log

[Install]
WantedBy=multi-user.target
